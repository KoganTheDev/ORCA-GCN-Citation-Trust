        <mxCell id="XbRxByp-cVwqAA4jbAIY-142" parent="1" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;" value="&lt;h1&gt;Multi-Modal Feature Vector&lt;/h1&gt;&lt;div&gt;&lt;span class=&quot;math-inline&quot; data-math=&quot;z_e = [s_{ORC} \parallel s_{GCN} \parallel s_{temp} \parallel s_{context}]&quot; data-index-in-node=&quot;13&quot; style=&quot;font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important;&quot;&gt;&lt;font style=&quot;font-size: 30px;&quot;&gt;\( Z_e = [\kappa + \gamma_{GCN} + \delta_{temp} + \theta_{sem}] \)&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;" vertex="1">
